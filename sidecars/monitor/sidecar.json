{
  "display_name": "Context Window Monitor",
  "description": "Lightweight on-demand context window, subagent, model quota, and cost monitor built on Antigravity sidecar_sdk.",
  "command": "node",
  "args": ["main.mjs"],
  "restart_policy": "always",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": false
  },
  "ui_config": {
    "display_name": "Context Window Monitor",
    "views": [
      {
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "path": "/",
        "title": "Context Window Monitor"
      }
    ]
  }
}
